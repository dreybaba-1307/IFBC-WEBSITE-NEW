# ── Admin area ────────────────────────────────────────────────────────────────
# Password for /admin (defaults to "ifbc-admin" when unset)
ADMIN_PASSWORD="change-this-password"

# Secret used to sign the admin session cookie. Use a long random string.
ADMIN_SECRET="change-this-to-a-long-random-secret"

# ── Database (TiDB Cloud) ─────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the local JSON file store (data/content.json).
# Set it to the TiDB Cloud connection string to persist everything in TiDB.
#
# Format:
#   mysql://<user>.root:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/ifbc
#
# The database in the URL is created by `npm run db:init` if it does not exist.
DATABASE_URL=""

# Optional overrides
# TIDB_DATABASE="ifbc"        # database name, when you don't want the one in the URL
# TIDB_POOL_SIZE="5"          # connection pool size
# TIDB_NO_SSL="1"             # disable TLS (only for a local MySQL/TiDB, never for TiDB Cloud)
# CONTENT_CACHE_TTL_MS="15000" # public read cache; 0 disables it
